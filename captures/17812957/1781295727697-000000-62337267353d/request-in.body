2: fn optimize_openai_payload(body: &str, workspace_hash: &str) -> (String, bool) {\n2123:     let Ok(mut value) = serde_json::from_str::<serde_json::Value>(body) else {\n2124:         return (body.to_string(), true);\n2125:     };\n2126:     let Some(obj) = value.as_object_mut() else {\n2127:         return (body.to_string(), true);\n2128:     };\n2129: \n2130:     let model = obj.get(\"model\").and_then(|m| m.as_str()).unwrap_or(\"\");\n2131:     let is_gpt55 = model == \"gpt-5.5\" || model.starts_with(\"gpt-5.5-\");\n2132:     if is_gpt55 && !obj.contains_key(\"prompt_cache_retention\") {\n2133:         obj.insert(\"prompt_cache_retention\".to_string(), json!(\"24h\"));\n2134:     }\n2135:     if !obj.contains_key(\"prompt_cache_key\") {\n2136:         let short_workspace = &workspace_hash[..workspace_hash.len().min(16)];\n2137:         obj.insert(\n2138:             \"prompt_cache_key\".to_string(),\n2139:             json!(format!(\"ostk:gpt:{}\", short_workspace)),\n2140:         );\n2141:     }\n2142: \n2143:     match serde_json::to_string(&value) {\n2144:         Ok(s) => (s, false),\n2145:         Err(_) => (body.to_string(), false),\n2146:     }\n2147: }\n2148: \n2149: /// Short session prefix (first 6 chars) for the per-turn line. Sessions\n2150: /// in the wild are 80+ char `<workspace>:<api-hash>` composites; the\n2151: /// full string isn't useful in a tail-able log.\n2152: fn short_session(s: &str) -> &str {\n2153:     let end = s.char_indices().nth(6).map(|(i, _)| i).unwrap_or(s.len());\n2154:     &s[..end]\n2155: }\n2156: \n2157: /// →1856 P2: a template \"has signal\" when it meets all three:\n2158: ///\n2159: ///   1. ≥3 *informative* tokens. A token is informative when it\n2160: ///      isn't `<*>`, is at least two chars long, and contains at\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}}}]},{"role":"m